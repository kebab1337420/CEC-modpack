<?xml version="1.0"?>
<mod name="Bot Weapons and Equipment">
	<!--
		XML tweak deliberately disabled (Diesel 3.0 / .crate assets compatibility).

		tweak/units.xml adds the "armor_skin" extension to npc units so bots can wear armor
		skins. That mechanism goes through SuperBLT's XML tweaker, which needs to read the
		original file from the game asset database.

		This install uses the new asset format (assets/*.crate): there is no all.blb and no
		bundle_db.blb any more, so SuperBLT cannot open the database ("No 'all.blb' or
		'bundle_db.blb' found in 'assets' folder, not loading asset database!"), the tweak
		fails while loading the first character unit ("Wren asset load failed ... compile or
		runtime error!") and the game hangs on the main menu.

		No single unit is at fault: the whole bundle XML tweak mechanism is inoperative here.

		Consequence: bots show no armor skin (purely cosmetic). Everything else in the mod
		(weapons, equipment, crew management) is pure lua and is unaffected.

		Re-enable this line if SuperBLT ever supports .crate assets:
	<tweak definition="tweak/units.xml"/>
	-->
	<hooks script_path="mod.lua">
		<group hook_id="lib/">
			<group :hook_id="managers/">
				<post :hook_id="blackmarketmanager"/>
				<post :hook_id="criminalsmanager"/>
				<post :hook_id="menumanager"/>
				<post :hook_id="menu/blackmarketgui"/>
				<post :hook_id="menu/crewmanagementgui"/>
				<post :hook_id="menu/menuscenemanager"/>
			</group>
			<group :hook_id="tweak_data/">
				<post :hook_id="charactertweakdata"/>
				<post :hook_id="weapontweakdata"/>
			</group>
			<group :hook_id="units/enemies/cop/">
				<post :hook_id="actions/full_body/copactionact"/>
				<post :hook_id="actions/upper_body/copactionshoot"/>
				<post :hook_id="copinventory"/>
			</group>
			<group :hook_id="units/player_team/">
				<post :hook_id="logics/teamailogictravel"/>
				<post :hook_id="huskteamaiinventory"/>
				<post :hook_id="teamaiinventory"/>
				<post :hook_id="teamaimovement"/>
			</group>
			<group :hook_id="units/weapons/">
				<post :hook_id="akimboweaponbase"/>
				<post :hook_id="newnpcraycastweaponbase"/>
			</group>
			<post :hook_id="network/base/networkpeer"/>
		</group>
	</hooks>
</mod>